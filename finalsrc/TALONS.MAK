		DIGITY.HCR DIGITZ.HCR DIGITCO.HCR PAUSED.HCR\
		COMPASS0.HCR COMPASS1.HCR COMPASS2.HCR COMPASS3.HCR\
		COMPASS4.HCR COMPASS5.HCR COMPASS6.HCR COMPASS7.HCR\
		COMPASS8.HCR COMPASS9.HCR COMPASSA.HCR COMPASSB.HCR\
		COMPASSC.HCR COMPASSN.HCR COMPASSS.HCR COMPASSE.HCR\
		COMPASSW.HCR COMPASSX.HCR ERADAR.HCR LANDED.HCR\
		ALT0.HCR ALT1.HCR ALT2.HCR COMPLETE.ASM
		XS TALONS

TALONS.EQU:	TALONS.SYM
		ECHO Updating TALONS.EQU...
		SYM2EQU TALONS.SYM TALONS.EQU

HISCORE.BIN:	HISCORE.ASM MACROS.INC TALONS.EQU SHOWT.HCR SHOWB.HCR\
		HSCORE.HCR HSCORE.SCB HSCORE.PAL ENTERT.HCR ENTERB.HCR
		X HISCORE

ATRACT.BIN:	ATRACT.ASM MACROS.INC TALONS.EQU
		X ATRACT

SELECT.BIN:	SELECT.ASM MACROS.INC TALONS.EQU
		X SELECT

MOVEMENT.BIN:	MOVEMENT.ASM MACROS.INC TALONS.EQU
		X MOVEMENT

PASSFAIL.BIN:	PASSFAIL.ASM MACROS.INC TALONS.EQU PF1.PAL\
		PASS.HCR FAIL.HCR ACE.HCR TIME.HCR BONUS.HCR
		X PASSFAIL

DEBRIEF.BIN:	DEBRIEF.ASM MACROS.INC TALONS.EQU DBRIEF.PAL\
		DBRIEF.HCR DFAIL.HCR DPASS.HCR DACE.HCR
		X DEBRIEF

SHOWMAP.BIN:	SHOWMAP.ASM MACROS.INC TALONS.EQU MV0.HCR MV1.HCR MV2.HCR\
		MXX1.HCR MXX2.HCR MV3.HCR MV4.HCR MV5.HCR MV6.HCR MV7.HCR
		X SHOWMAP

