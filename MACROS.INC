		STA	DEST+1
		ENDM
*
* INCREMENT WORD
*
INCW		MACRO	DEST
		INC	DEST+0
		BNE	?MLBL#
		INC	DEST+1
?MLBL#
		ENDM
*
* DECREMENT WORD
*
DECW		MACRO	DEST
		LDA	DEST+0
		SEC
		SBC	#1
		STA	DEST+0
		BCS	?MLBL#
		DEC	DEST+1
?MLBL#
		ENDM
*
* GET COSINE
*
* PARAMETERS
*	XYZ	X,Y, OR Z
*
_COS1		MACRO	XYZ
		LDX	W|XYZ|ROTATION+1	;GET HIGH BYTE INDEX

		LDA	COSSIGN,X		;SET SIGN FOR COSINE
		STA	|XYZ|CSIGN		;

		STZ	|XYZ|CEFFECT1+1		;INIT HIGH BYTE

		LDA	COSDIR,X		;INVERT?
		BEQ	?MLBL1#			;NO

		LDA	#255			;YES - INVERT INDEX
		SEC				;
		SBC	W|XYZ|ROTATION+0	;
		TAX				;

		LDA	COSSINLO+1,X		;GET COSINE EFFECT
		STA	|XYZ|CEFFECT1+0		;NOTE: +1,X
		BNE	?MLBL3#			;
		CPX	#255			;
		BEQ	?MLBL3#			;
		BRA	?MLBL2#			;
?MLBL1#
		LDX	W|XYZ|ROTATION+0	;GET LOW BYTE INDEX

		LDA	COSSINLO,X		;GET COSINE EFFECT
		STA	|XYZ|CEFFECT1+0		;
		BNE	?MLBL3#			;
?MLBL2#
		INC	|XYZ|CEFFECT1+1		;
?MLBL3#
		LDA	|XYZ|CSIGN		;
		BEQ	?MLBL4#			;

		LDA	|XYZ|CEFFECT1+0		;
		EOR	#$FF			;
		CLC				;
		ADC	#$01			;
		STA	|XYZ|CEFFECT1+0		;
		LDA	|XYZ|CEFFECT1+1		;
		EOR	#$FF			;
		ADC	#$00			;
		STA	|XYZ|CEFFECT1+1		;
?MLBL4#
		ENDM
*
* GET SINE
*
* PARAMETERS
*	XYZ	X,Y, OR Z
*
_SIN1		MACRO	XYZ
		LDX	W|XYZ|ROTATION+1	;GET HIGH BYTE INDEX

		LDA	SINSIGN,X		;SET SIGN FOR SINE
		STA	|XYZ|SSIGN		;

		STZ	|XYZ|SEFFECT1+1		;INIT HIGH BYTE

		LDA	SINDIR,X		;INVERT?
		BEQ	?MLBL1#			;NO

		LDA	#255			;YES - INVERT INDEX
		SEC				;
		SBC	W|XYZ|ROTATION+0	;
		TAX				;

		LDA	COSSINLO+1,X		;GET SINE EFFECT
		STA	|XYZ|SEFFECT1+0		;NOTE: +1,X
		BNE	?MLBL3#			;
		CPX	#255			;
		BEQ	?MLBL3#			;
		BRA	?MLBL2#			;
?MLBL1#
		LDX	W|XYZ|ROTATION+0	;GET LOW BYTE INDEX

		LDA	COSSINLO,X		;GET SINE EFFECT
		STA	|XYZ|SEFFECT1+0		;
		BNE	?MLBL3#			;
?MLBL2#
		INC	|XYZ|SEFFECT1+1		;
?MLBL3#
		LDA	|XYZ|SSIGN		;
		BEQ	?MLBL4#			;

		LDA	|XYZ|SEFFECT1+0		;
		EOR	#$FF			;
		CLC				;
		ADC	#$01			;
		STA	|XYZ|SEFFECT1+0		;
		LDA	|XYZ|SEFFECT1+1		;
		EOR	#$FF			;
		ADC	#$00			;
		STA	|XYZ|SEFFECT1+1		;
?MLBL4#
		LDA	|XYZ|SEFFECT1+0		;SAVE NEGATED SIGN EFFECT
		EOR	#$FF			;
		CLC				;
		ADC	#$01			;
		STA	|XYZ|NSEFFECT1+0	;
		LDA	|XYZ|SEFFECT1+1		;
		EOR	#$FF			;
		ADC	#$00			;
		STA	|XYZ|NSEFFECT1+1	;
		ENDM
*
* GET COSINE
*
* PARAMETERS
*	XYZ	X,Y, OR Z
*
_COS2		MACRO	XYZ
		LDX	SUN|XYZ|ROT+1		;GET HIGH BYTE INDEX

		LDA	COSSIGN,X		;SET SIGN FOR COSINE
		STA	|XYZ|CSIGN		;

		STZ	|XYZ|CEFFECT2+1		;INIT HIGH BYTE

		LDA	COSDIR,X		;INVERT?
		BEQ	?MLBL1#			;NO

		LDA	#255			;YES - INVERT INDEX
		SEC				;
		SBC	SUN|XYZ|ROT+0		;
		TAX				;

		LDA	COSSINLO+1,X		;GET COSINE EFFECT
		STA	|XYZ|CEFFECT2+0		;NOTE: +1,X
		BNE	?MLBL3#			;
		CPX	#255			;
		BEQ	?MLBL3#			;
		BRA	?MLBL2#			;
?MLBL1#
		LDX	SUN|XYZ|ROT+0		;GET LOW BYTE INDEX

		LDA	COSSINLO,X		;GET COSINE EFFECT
		STA	|XYZ|CEFFECT2+0		;
		BNE	?MLBL3#			;
?MLBL2#
		INC	|XYZ|CEFFECT2+1		;
?MLBL3#
		LDA	|XYZ|CSIGN		;
		BEQ	?MLBL4#			;

		LDA	|XYZ|CEFFECT2+0		;
		EOR	#$FF			;
		CLC				;
		ADC	#$01			;
		STA	|XYZ|CEFFECT2+0		;
		LDA	|XYZ|CEFFECT2+1		;
		EOR	#$FF			;
		ADC	#$00			;
		STA	|XYZ|CEFFECT2+1		;
?MLBL4#
		ENDM
*
* GET SINE
*
* PARAMETERS
*	XYZ	X,Y, OR Z
*
_SIN2		MACRO	XYZ
		LDX	SUN|XYZ|ROT+1		;GET HIGH BYTE INDEX

		LDA	SINSIGN,X		;SET SIGN FOR SINE
		STA	|XYZ|SSIGN		;

		STZ	|XYZ|SEFFECT2+1		;INIT HIGH BYTE

		LDA	SINDIR,X		;INVERT?
		BEQ	?MLBL1#			;NO

		LDA	#255			;YES - INVERT INDEX
		SEC				;
		SBC	SUN|XYZ|ROT+0		;
		TAX				;

		LDA	COSSINLO+1,X		;GET SINE EFFECT
		STA	|XYZ|SEFFECT2+0		;NOTE: +1,X
		BNE	?MLBL3#			;
		CPX	#255			;
		BEQ	?MLBL3#			;
		BRA	?MLBL2#			;
?MLBL1#
		LDX	SUN|XYZ|ROT+0		;GET LOW BYTE INDEX

		LDA	COSSINLO,X		;GET SINE EFFECT
		STA	|XYZ|SEFFECT2+0		;
		BNE	?MLBL3#			;
?MLBL2#
		INC	|XYZ|SEFFECT2+1		;
?MLBL3#
		LDA	|XYZ|SSIGN		;
		BEQ	?MLBL4#			;

		LDA	|XYZ|SEFFECT2+0		;
		EOR	#$FF			;
		CLC				;
		ADC	#$01			;
		STA	|XYZ|SEFFECT2+0		;
		LDA	|XYZ|SEFFECT2+1		;
		EOR	#$FF			;
		ADC	#$00			;
		STA	|XYZ|SEFFECT2+1		;
?MLBL4#
		LDA	|XYZ|SEFFECT2+0		;SAVE NEGATED SIGN EFFECT
		EOR	#$FF			;
		CLC				;
		ADC	#$01			;
		STA	|XYZ|NSEFFECT2+0	;
		LDA	|XYZ|SEFFECT2+1		;
		EOR	#$FF			;
		ADC	#$00			;
		STA	|XYZ|NSEFFECT2+1	;
		ENDM
