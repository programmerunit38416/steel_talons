*
* SET UP RGB PALETTE
*
MYRGB16		MACRO	DEST
		LDY	#31		;SAME AS RGB16 MACRO BUT WITH
?MLBL#					;	ABSOLUTE ADDRESSING
		LDA	DEST,Y		;
		STA	GREEN0,Y	;
		DEY			;
		BPL	?MLBL#		;
		ENDM
*
* SET UP RGB PALETTE - INDIRECT
*
MYRGB16I	MACRO	DEST
		LDY	#31		;SAME AS RGB16 MACRO BUT WITH
?MLBL#					;	ABSOLUTE ADDRESSING
		LDA	(DEST),Y	;
		STA	GREEN0,Y	;
		DEY			;
		BPL	?MLBL#		;
		ENDM
*
* CLEAR BYTE MACRO
*
CLRB		MACRO	DEST
		STZ	DEST
		ENDM
*
* CLEAR WORD MACRO
*
CLRW		MACRO	DEST
		STZ	DEST+0
		STZ	DEST+1
		ENDM
*
* CLEAR TRIPLE MACRO
*
CLRT		MACRO	DEST
		STZ	DEST+0
		STZ	DEST+1
		STZ	DEST+2
		ENDM
*
* CLEAR LONG MACRO
*
CLRL		MACRO	DEST
		STZ	DEST+0
		STZ	DEST+1
		STZ	DEST+2
		STZ	DEST+3
		ENDM
*
* NEGATE BYTE MACRO
*
NEGB		MACRO	SOURCE,DEST
	IFMA	2
		LDA	SOURCE
		EOR	#$FF
		CLC
		ADC	#$01
		STA	DEST
	ELSE
		LDA	DEST
		EOR	#$FF
		CLC
		ADC	#$01
		STA	DEST
	ENDIF
		ENDM
*
* NEGATE WORD MACRO
*
NEGW		MACRO	SOURCE,DEST
	IFMA	2
		LDA	SOURCE+0
		EOR	#$FF
		CLC
		ADC	#$01
		STA	DEST+0
		LDA	SOURCE+1
		EOR	#$FF
		ADC	#$00
		STA	DEST+1
	ELSE
		LDA	SOURCE+0
		EOR	#$FF
		CLC
		ADC	#$01
		STA	SOURCE+0
		LDA	SOURCE+1
		EOR	#$FF
		ADC	#$00
		STA	SOURCE+1
	ENDIF
		ENDM
*
