*
* ROTATION MACROS
*
DOROTATE1	MACRO
		SIGNEDMATH			;SET SIGNED MATH
		JSR	ROTATEX1@		;ROTATE ABOUT X (ROLL)
		JSR	ROTATEY1@		;ROTATE ABOUT Y (PITCH)
		JSR	ROTATEZ1@		;ROTATE ABOUT Z (YAW)
		ENDM
*
DOROTATEV	MACRO
		SIGNEDMATH			;SET SIGNED MATH
		LDA	SORTINDEX		;GROUND.TSK?
		BEQ	?ITSGROUND3#		;YES

		JSR	ROTATEZV@		;ROTATE ABOUT Z (YAW)
?ITSGROUND3#
		JSR	ROTATEYV@		;ROTATE ABOUT Y (PITCH)
		JSR	ROTATEXV@		;ROTATE ABOUT X (ROLL)
		ENDM
*
DOROTATE2	MACRO
		SIGNEDMATH			;SET SIGNED MATH
		JSR	ROTATEY2@		;ROTATE ABOUT Y (PITCH)
		JSR	ROTATEX2@		;ROTATE ABOUT X (ROLL)
