*
* CHECK FOR OVERFLOW AFTER ROTATION
*
* PARAMETERS:
*	WORKX	LOW WORD OF SIGNED RESULT
*	ROTWORK	HIGH BYTE OF SIGNED RESULT
*
	IF	USEROTCHK=TRUE
ROTCHK		MACRO	PARM
		LDA	ROTWORK+2		;
		BPL	?MLBLPOS#		;
?MLBLNEG#
		CMP	#$FF			;
		BNE	?MLBLBADNEG#		;
		LDA	ROTWORK+1		;
		CMP	#>MINCOORD		;
		BGE	?MLBLOKAY#		;
?MLBLBADNEG#
		MOVEIW	MINCOORD,PARM		;
		BRA	?MLBLDONE#		;
?MLBLPOS#
		BNE	?MLBLBADPOS#		;
		LDA	ROTWORK+1		;
		CMP	#>MAXCOORD		;
		BLT	?MLBLOKAY#		;
?MLBLBADPOS#
		MOVEIW	MAXCOORD,PARM		;
		BRA	?MLBLDONE#		;
?MLBLOKAY#
		STA	PARM+1			;
		LDA	ROTWORK+0		;
		STA	PARM+0			;
?MLBLDONE#
		ENDM
	ELSE
ROTCHK		MACRO	PARM
		MOVEW	ROTWORK,PARM
		ENDM
	ENDIF
